# Copy to .env and fill in what you need: cp .env.example .env
# docker compose reads this automatically.
#
# Upgrading an install made under the old name (Timberdoodle)? Your old
# TIMBERDOODLE_* variables keep working under docker compose - every
# BALER_* setting falls back to its TIMBERDOODLE_* name. Also set the three
# "legacy install" values in the postgres section below, or compose will
# start you on a fresh, empty database. Full steps:
# deploy/MIGRATING-TO-BALER.md.

# --- required: gateway-enforced auth (auth_api.py + gateway/njs/) ---
# `docker compose up -d` refuses to start the gateway without both of
# these set - every API route goes through JWT verification in nginx
# itself now (see README's "Gateway auth" section), so an unset secret
# would mean the gateway can't check anything. Generate real ones with
# e.g. `openssl rand -hex 32` - these are HMAC keys, not passwords, so a
# long random string, not something memorable.
BALER_JWT_SECRET=
# Shared between the gateway and every backend - lets a backend confirm
# a request actually came through the gateway's js_access checks rather
# than hitting its container port directly from a sibling on the same
# compose network (see src/baler/gateway_auth.py). A different
# secret from BALER_JWT_SECRET above - this one is never put in a
# token, just compared header-to-env-var.
BALER_GATEWAY_SECRET=
# Optional: key for source-registry secrets at rest (Ops -> Sources
# passwords/DSNs). Defaults to a key derived from BALER_GATEWAY_SECRET -
# set this if you want to rotate the gateway secret without losing them.
BALER_SOURCES_KEY=

# --- required: mosquitto auth (docker-compose.yml's mosquitto service +
# mosquitto/acl) - `docker compose up -d` refuses to start mosquitto or
# any MQTT-connected daemon without this. Password for the shared
# "baler" backend account (mqtt_listener, fault_detector,
# derivation_engine, and the integration test suite all connect as this
# user - see mosquitto/acl). Generate one with e.g. `openssl rand -hex 16`.
# Windrows at a site (edge nodes) get their own per-site accounts from
# Ops -> Edge nodes (see BALER_MQTT_PUBLIC_* below and multi-site.mdx) -
# not here, and no longer hand-added to MOSQUITTO_USERS.
MQTT_PASSWORD=

# Edge nodes (Ops -> Edge nodes, Baler#36): Windrows publishing from outside
# this host get their own per-site broker accounts, created in the UI - not
# here. These only tell a new node where to connect (shown with its
# password). Blank host = the UI says "<this server's address>".
BALER_MQTT_PUBLIC_HOST=
BALER_MQTT_PUBLIC_PORT=1883
BALER_MQTT_PUBLIC_TLS_PORT=
# A directory holding the broker's TLS cert (cert.pem + key.pem, or a
# Caddy-style <host>.crt + <host>.key - Caddy's own certificate dir works
# as-is). Set: mosquitto also listens on 8883 with TLS. Blank: plain 1883
# only. nash-srv: setup-runner.sh step 7 sets it to Caddy's cert dir.
BALER_MQTT_TLS_DIR=

# --- optional, nash-srv only: host-network Windrow for LAN discovery
# (deploy/nash-srv/docker-compose.lan.yml, Baler#78, docs-site edge-nodes).
# Off unless BALER_WINDROW_LAN=1 (the deploy wrapper then adds the file).
# Not needed to poll known devices by IP - windrow_api does that already.
BALER_WINDROW_LAN=
WINDROW_LAN_ADDRESS=            # the host's LAN address, port 47808: 192.168.128.145/24:47808
WINDROW_LAN_SITE_ID=            # an Ops -> Edge nodes account's username (= its site)
WINDROW_LAN_MQTT_PASSWORD=      # that account's password
WINDROW_LAN_MODBUS_CIDR=        # the LAN to sweep for Modbus TCP: 192.168.128.0/24
WINDROW_LAN_INSTANCE_ID=        # optional, default nash-srv-lan
WINDROW_LAN_API_PORT=           # optional, default 8011 (bound to 127.0.0.1 only)

# --- docker compose / postgres ---
POSTGRES_PASSWORD=baler          # optional, defaults to the role name (BALER_PG_USER) if unset
# Legacy install only (created before the Baler rename): keep the existing
# Postgres role/database and docker volumes by setting all three to
# "timberdoodle". New installs leave them unset (everything is "baler").
BALER_PG_USER=
BALER_PG_DB=
BALER_VOLUME_PREFIX=

# --- optional: point_history compression (docs-site: history-compression) ---
# A history chunk is compressed (columnar, segmented by point) once all of
# it is older than this. Any Postgres interval. Late writes into compressed
# chunks still work, just slower, so this is how much late data (trend
# backfill, an edge node's spool after an outage) takes that path. The
# migrate service and every process re-check it once at start and replace
# the policy if it changed. Default 7 days.
BALER_HISTORY_COMPRESS_AFTER=
# Length of each new point_history chunk (any Postgres interval). Blank
# leaves the hypertable as it is: 7 days on every install so far, right for
# a small site. A site ingesting thousands of rows/s wants hours, with
# compress_after a few chunks (100k points every 5 s: 1 hour and 3 hours).
# Existing chunks are never rewritten: the chunk open at the time keeps its
# range and the new length starts at its end. Sizing:
#   python -m baler.history_chunks recommend --points 100000 --pg-memory 32g
BALER_HISTORY_CHUNK_INTERVAL=
# How often the compression policy runs. Blank: half a chunk (12 hours from
# 1-day chunks up) once BALER_HISTORY_CHUNK_INTERVAL is set, otherwise left
# as it is (12 hours).
BALER_HISTORY_COMPRESS_SCHEDULE=

# --- optional: the reading feed (docs-site: fault-detection, scale-test) ---
# mqtt_listener appends every committed batch to the reading_feed table;
# fault_detector and derivation_engine read it from durable offsets instead
# of subscribing to all telemetry over QoS 0 (#243). A batch a daemon hasn't
# read is kept this many seconds, then pruned and counted as missed
# (missed_readings in /ops/status, the daemon's card turns degraded).
# Bigger survives a longer daemon outage and costs that much more table
# while it's down. Default 600.
BALER_FEED_RETENTION_S=

# --- optional: ingest listener worker processes (#233) ---
# mqtt_listener runs this many workers on the MQTT 5 shared subscription
# $share/baler/fbf/#, each its own process (one GIL each) with a stable
# client id and persistent session. One worker stores ~15k readings/s on
# nash-srv; set it when the stored rate approaches that, or when the
# listener's heartbeat shows blocked_s growing or its log shows "BROKER
# DROPPED". Lowering it retires the extra workers' broker sessions at the
# next start (their queued readings are stored first). Default 1.
BALER_LISTENER_WORKERS=

# --- optional: read page sizes (docs-site: haystack-api, his-query) ---
# A Haystack read-by-filter with no `limit` returns at most BALER_READ_LIMIT
# records, and GET /ingest/his at most BALER_HIS_SERIES_LIMIT series, per
# request; a longer result says where to continue (`after`), so a read of a
# 100k-point graph answers in bounded time instead of building everything
# (#244). Graphs smaller than the limit see no difference. 0 turns a limit
# off (everything in one response, as before - for a third-party
# Haystack client that can't follow `after`). Defaults 1000 and 1000.
BALER_READ_LIMIT=
BALER_HIS_SERIES_LIMIT=

# --- optional: default timezone for GET /ingest/his and /api/*/hisRead ---
# `hisRead(today)` / `thisMonth` / `1day` rollup buckets are local days
# in this zone (IANA name, e.g. America/Chicago) when a request doesn't
# pass its own ?tz=. Defaults to UTC. The Query UI (ui/his.html) always
# sends the browser's zone, so this only affects API clients/scripts.
# See docs-site/pages/his-query.mdx.
BALER_TZ=

# --- docker compose / grafana ---
# Off by default - log in with the image's default admin/admin (change it
# on first login). Only set to "true" for local dev convenience; never in
# production (anonymous Admin access to every dashboard).
GRAFANA_ANON_ENABLED=false

# --- ops_api: the Connectors page (baler.edges) ---
# A Windrow (windrow.api) running beside Baler, reached over HTTP with
# BALER_GATEWAY_SECRET - e.g. http://windrow_api:8001 when the
# deploy/nash-srv windrow overlay is used. Blank: only remote Windrows show,
# found by their cmd/<site>/<instance>/status heartbeat over MQTT.
WINDROW_API_URL=

# --- deploy/nash-srv windrow overlay: device announce (windrow.announce) ---
# windrow_api listens for "I am here" datagrams on UDP 47900, published on
# the host as WINDROW_ANNOUNCE_PORT, and only hears sources inside
# WINDROW_ANNOUNCE_ALLOW (a CIDR; the LAN the devices are on). Connections
# whose device_name matches an announcing device follow it to a new address.
WINDROW_ANNOUNCE_ALLOW=          # optional, default 192.168.128.0/24
WINDROW_ANNOUNCE_PORT=           # optional, default 47900

# --- only needed running a `python -m baler.*` process bare-metal,
#     outside docker compose (inside Docker these are set for you, see the
#     x-daemon-env anchor in docker-compose.yml) ---
BALER_PG_DSN=
OXIGRAPH_URL=
MQTT_HOST=
MQTT_USERNAME=baler       # matches mosquitto/acl's "baler" user - see MQTT_PASSWORD above
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- autotag.py's model step (#182) ---
# Uses the same BALER_LLM_PROVIDER as commissioning (below): Claude, an
# OpenAI-compatible endpoint, or none (rules + proposals only). Also read
# by commissioning_api: with it set (and BALER_LLM_PROVIDER blank) spec PDF
# extraction (Cx 7) and the agent (Cx 10) use Claude.
ANTHROPIC_API_KEY=
# The tagging model. Default: claude-haiku-5-5, the current Haiku
# (anthropic), or BALER_LLM_MODEL (openai). Not BALER_CX_MODEL, which
# defaults to the current Opus (claude-opus-5-5): autotag asks twice per
# naming pattern, so a small model is the right default. Both defaults
# live in src/baler/commissioning/llm.py.
BALER_TAG_MODEL=

# --- commissioning_api (Cx 7, Cx 10): which model, if any ---
# BALER_LLM_PROVIDER: anthropic | openai | none.
#   anthropic - the Claude API: ANTHROPIC_API_KEY, model BALER_CX_MODEL.
#   openai    - any OpenAI-compatible Chat Completions endpoint at
#               BALER_LLM_BASE_URL (Ollama, Groq, Gemini, OpenRouter,
#               OpenAI, vLLM). PDFs: their text is sent page by page and an
#               item whose quote isn't on its page is dropped. The agent
#               needs a model with function calling.
#   none      - no model, offline, free: PDF equipment schedules and point
#               lists are read from tables locally (pdfplumber, the cx-spec
#               extra); the agent answers 501.
# Blank: anthropic if ANTHROPIC_API_KEY is set, else openai if
# BALER_LLM_BASE_URL is set, else none. Every provider reads tables
# locally first and only sends a model what they don't cover.
BALER_LLM_PROVIDER=
BALER_LLM_BASE_URL=                     # openai: the endpoint, up to /v1 (see free options below)
BALER_LLM_API_KEY=                      # openai: Bearer key; blank for Ollama
BALER_LLM_MODEL=                        # openai: the endpoint's model name (required); anthropic: used if BALER_CX_MODEL is blank
# Optional openai tuning: seconds per request (CPU-only Ollama is slow),
# PDF text characters per request (small local models have small
# contexts), and reply tokens per request.
BALER_LLM_TIMEOUT=                      # default 300
BALER_LLM_MAX_CHARS=                    # default 12000
BALER_LLM_MAX_TOKENS=                   # default 4096
#
# Free options (openai provider). Free hosted tiers may use what you send
# for training: fine for demo data, NOT for confidential specs - use
# Ollama (local) or a paid tier for those.
#   Ollama (local, no key; uncomment the ollama service in docker-compose.yml,
#   `docker compose --profile llm-local up -d ollama`,
#   then `docker compose exec ollama ollama pull qwen2.5:7b`):
#     BALER_LLM_PROVIDER=openai
#     BALER_LLM_BASE_URL=http://ollama:11434/v1
#     BALER_LLM_MODEL=qwen2.5:7b          # or llama3.1:8b; llama3.2:3b is smaller but weaker at tools
#   Groq (free tier, key from console.groq.com):
#     BALER_LLM_BASE_URL=https://api.groq.com/openai/v1
#     BALER_LLM_MODEL=llama-3.3-70b-versatile
#   Google Gemini (free tier, key from aistudio.google.com):
#     BALER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     BALER_LLM_MODEL=gemini-2.5-flash
#   OpenRouter (free models end in :free, key from openrouter.ai):
#     BALER_LLM_BASE_URL=https://openrouter.ai/api/v1
#     BALER_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# The Claude model for spec PDF extraction and the commissioning agent
# (anthropic provider). Blank: BALER_LLM_MODEL, else the default in
# commissioning/llm.py (the current Opus).
BALER_CX_MODEL=
# Active commissioning tests (Cx 9) write to equipment through point_write
# (priority 8, admin only, scheduled window, relinquished afterwards) only
# when this is exactly 1. Leave blank on any install where Cx must stay
# read-only.
BALER_CX_ALLOW_WRITES=

# --- mock hospital demo: scripts/seed_derivations_and_faults.py ---
# The script logs in as this admin user itself (POST /auth/login) to get
# a Bearer token - create the account first with POST /auth/orgs if you
# don't have one yet (see README's "Gateway auth" section).
BALER_ADMIN_EMAIL=
BALER_ADMIN_PASSWORD=

# --- optional: allow fault_api.py/fault_detector.py to register and
#     deliver webhooks targeting loopback/private/link-local addresses.
#     Off by default (webhooks.validate_url rejects them - see the SSRF
#     note in docs-site/pages/webhooks.mdx). Only ever set this for local
#     dev/test against a receiver on localhost - never in production. ---
BALER_ALLOW_PRIVATE_WEBHOOKS=    # set to "1" to allow; anything else (including unset) stays secure

# --- optional: pull from a remote Haystack/Haxall/SkySpark server ---
# Only used by the haystack_puller service (docker compose --profile
# haystack-pull up -d haystack_puller). See docs-site/pages/haystack-puller.mdx.
REMOTE_HAYSTACK_URL=                    # leave blank and haystack_puller starts anyway, silently failing every pull cycle
REMOTE_HAYSTACK_USER=                   # same — set both before enabling the haystack-pull profile
REMOTE_HAYSTACK_PASSWORD=               # optional, defaults to ""
REMOTE_HAYSTACK_SOURCE_ID=haxall        # optional, defaults to "haxall"

# --- optional: pull point readings from an arbitrary external SQL source ---
# Only used by the sql_puller service (docker compose --profile sql-pull
# up -d sql_puller). Same blank-safe-but-silently-broken shape as
# REMOTE_HAYSTACK_URL above - leave unset and the container starts anyway,
# failing every pull cycle instead of refusing to start.
REMOTE_SQL_DSN=                         # postgres://... - Postgres-wire-compatible source only
REMOTE_SQL_QUERY=                       # must SELECT point, value, ts columns; use %(since)s/%(until)s placeholders
REMOTE_SQL_SOURCE_ID=sql                # optional, defaults to "sql"

# --- optional: pull ENERGY STAR scores/metrics from EPA Portfolio Manager ---
# Only used by the energystar_puller service (docker compose --profile
# energystar-pull up -d energystar_puller). Same blank-safe-but-silently-
# broken shape as REMOTE_HAYSTACK_URL above. Auth is your real Portfolio
# Manager account username/password (EPA's own web-service auth model,
# not a separate revocable key) - sign up free at
# https://portfoliomanager.energystar.gov/pm/signup, then register this
# integration under Account Settings > Software Development for live
# access (EPA reviews that request; the test environment below needs no
# such approval).
ENERGYSTAR_USERNAME=                    # your Portfolio Manager account username
ENERGYSTAR_PASSWORD=                    # your Portfolio Manager account password
ENERGYSTAR_ACCOUNT_ID=                  # optional - auto-discovered via GET /account if unset
ENERGYSTAR_LIVE=                        # set to "1" for /ws (real data); unset/anything else uses /wstest

# --- optional: pull current weather conditions from Open-Meteo (free,
# no API key/signup needed) as the WWW fallback/default when you don't
# have a local weather station wired up - see
# docs-site/pages/weather-stations.mdx. Only used by the openmeteo_puller
# service (docker compose --profile openmeteo-pull up -d openmeteo_puller).
# Same blank-safe-but-silently-broken shape as REMOTE_HAYSTACK_URL above -
# leave lat/long unset and the container starts anyway, failing every pull
# cycle (Open-Meteo 400s on a missing/blank latitude) instead of refusing
# to start.
OPENMETEO_LATITUDE=                     # decimal degrees, e.g. 37.7749
OPENMETEO_LONGITUDE=                    # decimal degrees, e.g. -122.4194
OPENMETEO_STATION_ID=openmeteo          # optional, defaults to "openmeteo"
OPENMETEO_UNITS=metric                  # metric (°C, km/h) or imperial (°F, mph)

# --- optional: only gate two e2e tests (test_haystack_client.py,
#     test_haystack_puller.py) against a real running Haxall instance.
#     Leave unset and those two tests skip cleanly. ---
HAXALL_OSS_URL=
HAXALL_SU_USERNAME=
HAXALL_SU_PASSWORD=

# Where fault_api/fault_detector/derivation_api/derivation_engine keep
# rules.json, webhooks.json and derivations.json. docker-compose.yml sets
# /data (the baler-data volume) - seeded once from the repo's copies, which
# are only seed data; leave blank for local runs (working directory).
BALER_DATA_DIR=

# --- Ops status page (ops_api) ---
OPS_QUIET_INGEST_SECONDS=900        # no ingest for this long -> the Ingest listener card says "quiet"
OPS_HEARTBEAT_STALE_SECONDS=180     # fault_detector/derivation_engine heartbeat older than this -> "down"
OPS_FEED_LAG_DEGRADED_SECONDS=60    # a rule daemon this far behind the reading feed -> "degraded"
# The gateway's 5xx log (gateway/nginx.conf writes it to the gateway-logs
# volume, mounted read-only in ops_api) behind GET /ops/gateway-errors.
# The default is where docker-compose.yml mounts it; leave blank.
BALER_GATEWAY_ERROR_LOG=
# tools/live-check (post-deploy verification, Baler#178) is not a Baler
# process and doesn't read this file: its BALER_TEST_* / LIVE_CHECK_* vars
# come from its own env file, see docs-site/pages/post-deploy-verify.mdx.

# --- optional: Baler Notebooks (docker compose --profile notebook up -d,
# see docs-site/pages/code/notebooks.mdx). Only the `jupyter` service (and
# a function project's compose.<project>.yml) reads these. ---
BALER_JUPYTER_TOKEN=                # required for the notebook: it refuses to start blank. e.g. $(openssl rand -hex 24)
BALER_JUPYTER_PORT=8888             # host port, bound to 127.0.0.1 only
BALER_NOTEBOOK_URL=http://gateway   # Baler as seen from inside the notebook container; a remote Baler's https URL also works
BALER_NOTEBOOK_API_KEY=             # a token from POST /auth/api-keys: viewer to read, operator to hisWrite
BALER_NOTEBOOK_PROJECT=demo         # the /api/<project> segment (doesn't scope anything yet)

# baler_fn.connect() itself reads these three (the jupyter service sets
# them from the BALER_NOTEBOOK_* values above). Set them yourself when you
# use baler_fn outside the container, e.g. BALER_URL=http://localhost:8080.
BALER_URL=
BALER_API_KEY=
BALER_PROJECT=demo

# The sample function project's compose file
# (templates/function-project/compose.baler-sample.yml): where the project
# lives relative to this checkout, its notebook's host port, and what its
# scheduled worker summarizes and how often.
BALER_SAMPLE_DIR=./templates/function-project
BALER_SAMPLE_PORT=8889
BALER_SAMPLE_POINT=                 # a point id for the worker, e.g. urn:point:fbf~2Fmock-ahu-1~2FanalogValue~2C1
BALER_SAMPLE_INTERVAL_SECONDS=3600

# Scale-test harness (scripts/scale/, Baler#190) - only ever in
# scripts/scale/scale.env (written by `scripts/scale/ladder.py init`), never
# in a live .env. The scale stack runs with its own BALER_VOLUME_PREFIX=scale,
# secrets and these ports (all 127.0.0.1); ladder.py refuses to run if any
# of them match a live install's defaults.
SCALE_GEN_MQTT_PASSWORD=            # the load generator's broker account (scalegen)
SCALE_MQTT_PORT=21883
SCALE_PG_PORT=25433
SCALE_OXIGRAPH_PORT=27878
SCALE_GATEWAY_PORT=28080
SCALE_GRAFANA_PORT=23033
SCALE_JAEGER_UI_PORT=26686
SCALE_OTLP_PORT=24318
SCALE_JUPYTER_PORT=28888
SCALE_CPUSET=                       # pin the whole scale stack to some host CPUs, e.g. 2-5
# SCALE_CPUS_<SERVICE>=1.5 / SCALE_MEM_<SERVICE>=4g cap one container
# (defaults in scripts/scale/compose.scale.yml; CPU caps are clamped to nproc)
# The Haxall baseline (Baler#236, ladder.py --target haxall; compose.haxall.yml,
# project <SCALE_PROJECT>-haxall). SCALE_CPUS_HAXALL/SCALE_MEM_HAXALL and
# SCALE_CPUS_HAXALL_BRIDGE/SCALE_MEM_HAXALL_BRIDGE default to Baler's matching caps.
SCALE_HAXALL_SU_PASSWORD=           # Haxall's su password (ladder.py init writes one)
SCALE_HAXALL_MQTT_PORT=22883
SCALE_HAXALL_HTTP_PORT=28280
SCALE_HAXALL_DURABILITY=            # how Haxall's history is fsync'd, once checked; blank = results not comparable
SCALE_HAXALL_VAR_VOLUME=            # an existing (e.g. sync-mounted) volume for Haxall's database ...
SCALE_HAXALL_VAR_EXTERNAL=false     # ... and true to use it
SCALE_HAXALL_JAVA_OPTS=             # JAVA_TOOL_OPTIONS for Haxall's JVM
SCALE_HAXALL_BRIDGE_MODE=auto       # haxall_bridge.py hisWrite: auto, batch or per-point
SCALE_HAXALL_BRIDGE_BATCH_ROWS=5000
SCALE_HAXALL_BRIDGE_BATCH_MS=250
# (haxall_bridge.py itself reads HAXALL_URL, HAXALL_USER, HAXALL_PASSWORD, HAXALL_BRIDGE_MODE,
# HAXALL_BRIDGE_BATCH_ROWS, HAXALL_BRIDGE_BATCH_MS and HAXALL_BRIDGE_INFLIGHT, which compose.haxall.yml sets.)
