# This is nash-srv's own env file, not the repo's .env.example.
#
# It lives at ~/.config/baler/nash-srv.env on the box, OUTSIDE any
# git checkout - actions/checkout runs `git clean -ffdx` on every deploy,
# which would delete it if it lived inside the runner's workspace (see
# setup-runner.sh). Create it once by hand, by copying this file there and
# filling in real values:
#   mkdir -p ~/.config/baler
#   cp deploy/nash-srv/.env.example ~/.config/baler/nash-srv.env
#   $EDITOR ~/.config/baler/nash-srv.env
#
# It is never committed, never a GitHub Actions secret - only the
# baler-deploy.sh wrapper on the box ever reads it
# (--env-file ~/.config/baler/nash-srv.env).

# Same HMAC-key requirements as the root .env.example - see there for why.
# Generate real values with `openssl rand -hex 32`, one run per line.
BALER_JWT_SECRET=
BALER_GATEWAY_SECRET=

# `openssl rand -hex 16`
MQTT_PASSWORD=
POSTGRES_PASSWORD=

# Deliberately absent: BALER_ALLOW_PRIVATE_WEBHOOKS. This box is
# reachable from the public internet - leaving it unset keeps the SSRF
# guard in webhooks.validate_url on, exactly like a real production
# deployment. Never set this to "1" here.
