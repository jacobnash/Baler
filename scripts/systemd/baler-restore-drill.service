[Unit]
Description=Baler restore drill (scripts/restore_drill.py)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# EDIT ME: path to this checkout.
WorkingDirectory=/opt/baler
Environment=PATH=/usr/bin:/usr/local/bin
# EDIT ME: a Python with this checkout installed (the drill imports baler
# for its checks), e.g. `python3 -m venv .venv && .venv/bin/pip install -e .`
# Restores the newest backup in backups/ into a scratch compose project
# (baler-restore-drill), checks it, removes it, and exits non-zero on any
# failed check, so `systemctl status`/`journalctl -u baler-restore-drill`
# show the result. The JSON report is overwritten on every run.
ExecStart=/opt/baler/.venv/bin/python scripts/restore_drill.py --report backups/restore-drill-latest.json
